{
    "name": "hampel/synergy-wholesale-laravel",
    "description": "Laravel service provider and facade for the Synergy Wholesale API client",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/synergy-wholesale-laravel/issues",
        "source": "https://github.com/hampel/synergy-wholesale-laravel"
    },
    "keywords": [
        "Synergy Wholesale",
        "domains",
        "DNS",
        "SSL",
        "API",
        "SOAP",
        "Laravel"
    ],
    "homepage": "https://github.com/hampel/synergy-wholesale-laravel",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "hampel/synergy-wholesale": "^2.1",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.4.2",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1.22",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\SynergyWholesale\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\SynergyWholesale\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hampel\\SynergyWholesale\\Laravel\\SynergyWholesaleServiceProvider"
            ],
            "aliases": {
                "SynergyWholesale": "Hampel\\SynergyWholesale\\Laravel\\Facades\\SynergyWholesale"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
