vendor/
composer.lock
composer.phar
.idea/
.phpunit.cache/
.phpunit.result.cache
.DS_Store

# session notes and audit state - local to this clone, never published
CLAUDE.local.md

# Secrets. Deliberately not anchored with a leading slash, so these match at any depth:
# an environment file can legitimately sit in a subdirectory rather than at the root.
# .env.* covers the named variants; a committed .env.example stays tracked.
.env
.env.*
!.env.example

# NTFS alternate data stream, left behind when a file is copied from Windows. It
# records the zone the download came from.
*:Zone.Identifier
