# Line endings.
#
# LF in the working tree as well as the index, so a Windows Git client sharing the
# working copy cannot rewrite every file to CRLF - a diff touching every file in the
# tree with no content change in any of them.
* text=auto eol=lf

# Keep development-only files out of the distributed archive.
/.editorconfig  export-ignore
/.gitattributes export-ignore
/.github        export-ignore
/.gitignore     export-ignore
/CLAUDE.md      export-ignore
/phpstan.neon   export-ignore
/phpunit.xml    export-ignore
/pint.json      export-ignore
/tests          export-ignore
